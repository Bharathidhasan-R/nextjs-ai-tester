{
  "name": "nextjs-ai-tester",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "playwright test",
    "test:playwright": "cross-env TEST_MODE=playwright playwright test --project=playwright",
    "test:ai": "cross-env TEST_MODE=ai AI_TESTING_ENABLED=true playwright test --project=ai",
    "test:hybrid": "cross-env TEST_MODE=hybrid AI_TESTING_ENABLED=true PLAYWRIGHT_ENABLED=true playwright test --project=hybrid",
    "test:local": "cross-env TARGET_ENV=local playwright test --project=playwright",
    "test:live": "cross-env TARGET_ENV=live playwright test --project=playwright",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:interactive": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:admin": "playwright test src/tests/admin.spec.ts --project=admin",
    "test:customer": "playwright test src/tests/customer.spec.ts --project=customer",
    "test:visual": "playwright test src/tests/visual.spec.ts --project=visual",
    "clean:reports": "node scripts/clean-reports.mjs",
    "test:clean": "node scripts/clean-reports.mjs",
    "clean": "node scripts/clean-reports.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^18.0.9",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
